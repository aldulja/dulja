{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "error", "suspicious": "error" },
  "rules": { "no-console": "error" },
  "overrides": [
    {
      "files": [
        "packages/*/src/cli.ts",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.stories.tsx",
        "tests/e2e/**"
      ],
      "rules": { "no-console": "off" }
    }
  ],
  "ignorePatterns": ["node_modules", "dist", "dist-main", ".turbo", "docs", "spikes"]
}
