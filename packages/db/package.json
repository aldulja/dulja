{
  "name": "@dulja/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./provision/verify-supabase": "./provision/verify-supabase.ts",
    "./test": "./test/index.ts",
    "./seed": "./src/seed/index.ts",
    "./seed/roles": "./seed/roles.ts",
    "./test/einvoice-stub": "./test/support/einvoice-stub.ts",
    "./staff/pin": "./src/staff/pin.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "db:migrate": "bun run src/cli.ts up",
    "db:rollback": "bun run src/cli.ts down",
    "db:status": "bun run src/cli.ts status",
    "db:lint": "bun run src/cli.ts lint",
    "provision:verify": "bun run provision/verify-supabase.ts",
    "reseed:verify": "bun ../../scripts/reseed-verify.ts",
    "seed": "bun run src/cli.ts seed",
    "seed:payroll-accounts": "bun src/seed/payroll-accounts.ts",
    "einvoice:verify": "bun run src/cli.ts einvoice-verify"
  },
  "dependencies": {
    "@dulja/domain": "workspace:*",
    "@supabase/supabase-js": "^2.116.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "hash-wasm": "^4.12.0",
    "pg-boss": "^12.32.0",
    "postgres": "^3.4.9",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@dulja/contracts": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.5.0",
    "drizzle-kit": "^0.31.10",
    "vitest": "^5.0.0"
  }
}
