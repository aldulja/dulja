{
  "code": "POS_TICKET",
  "nameEn": "POS Ticket",
  "nameAr": "فاتورة نقطة بيع",
  "module": "pos",
  "policyVersion": 1,
  "effectiveFrom": "2026-01-01",
  "policy": {
    "version": 1,
    "documentType": "POS_TICKET",
    "direction": "outbound",
    "requires": ["client_ref", "attributed_to", "warehouse"],
    "lines": [
      {
        "for": "each_line",
        "side": "credit",
        "account": {
          "from": "item.revenue_account"
        },
        "amount": "line.amount",
        "when": {
          "line.kind": "item",
          "line.quantity_sign": "positive"
        }
      },
      {
        "for": "each_line",
        "side": "debit",
        "account": {
          "from": "item.cogs_account"
        },
        "amount": "line.cost",
        "when": {
          "line.kind": "item",
          "line.quantity_sign": "positive"
        }
      },
      {
        "for": "each_line",
        "side": "credit",
        "account": {
          "from": "item.inventory_account"
        },
        "amount": "line.cost",
        "when": {
          "line.kind": "item",
          "line.quantity_sign": "positive"
        }
      },
      {
        "for": "each_line",
        "side": "credit",
        "account": {
          "from": "item.revenue_account"
        },
        "amount": "line.amount",
        "when": {
          "line.kind": "item",
          "line.quantity_sign": "negative"
        }
      },
      {
        "for": "each_line",
        "side": "credit",
        "account": {
          "from": "item.cogs_account"
        },
        "amount": "line.cost",
        "when": {
          "line.kind": "item",
          "line.quantity_sign": "negative"
        }
      },
      {
        "for": "each_line",
        "side": "debit",
        "account": {
          "from": "item.inventory_account"
        },
        "amount": "line.cost",
        "when": {
          "line.kind": "item",
          "line.quantity_sign": "negative"
        }
      },
      {
        "for": "each_line",
        "side": "debit",
        "account": {
          "code": "1110"
        },
        "amount": "line.amount",
        "when": {
          "line.kind": "tender",
          "line.tender_method": "cash"
        }
      },
      {
        "for": "each_line",
        "side": "debit",
        "account": {
          "code": "1120"
        },
        "amount": "line.amount",
        "when": {
          "line.kind": "tender",
          "line.tender_method": "card"
        }
      },
      {
        "for": "each_line",
        "side": "debit",
        "account": {
          "code": "1100"
        },
        "amount": "line.amount",
        "when": {
          "line.kind": "tender",
          "line.tender_method": "transfer"
        }
      },
      {
        "for": "each_line",
        "side": "debit",
        "account": {
          "code": "2200"
        },
        "amount": "line.amount",
        "when": {
          "line.kind": "tender",
          "line.tender_method": "store_credit"
        }
      },
      {
        "for": "each_tax",
        "side": "credit",
        "account": {
          "from": "tax_code.output_account"
        },
        "amount": "tax.amount"
      },
      {
        "for": "each_line",
        "side": "debit",
        "account": {
          "from": "party.receivable_account"
        },
        "amount": "line.debit",
        "when": {
          "line.kind": "account"
        }
      },
      {
        "for": "each_line",
        "side": "credit",
        "account": {
          "from": "party.receivable_account"
        },
        "amount": "line.credit",
        "when": {
          "line.kind": "account"
        }
      }
    ],
    "inventory": {
      "effect": "issue",
      "warehouse": "header.warehouse",
      "costing": "consume_layers",
      "allowNegative": false
    },
    "tax": {
      "applies": true,
      "inclusive": true
    },
    "numbering": {
      "series": "POS",
      "assignAt": "issue"
    },
    "reversal": {
      "allowed": true,
      "producesType": "POS_TICKET"
    },
    "approval": {
      "required": false,
      "approve": null,
      "post": "pos.sync.push"
    },
    "fxRoundingAccount": {
      "from": "company.fx_rounding_account_id"
    },
    "dimensions": {
      "required": ["BRANCH"]
    }
  }
}
