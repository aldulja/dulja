{
  "code": "PURCHASE_CREDIT_NOTE",
  "nameEn": "Purchase Credit Note",
  "nameAr": "\u0625\u0634\u0639\u0627\u0631 \u062f\u0627\u0626\u0646 \u0644\u0644\u0634\u0631\u0627\u0621",
  "module": "accounting",
  "policyVersion": 2,
  "effectiveFrom": "2026-01-01",
  "policy": {
    "version": 1,
    "documentType": "PURCHASE_CREDIT_NOTE",
    "direction": "outbound",
    "requires": ["party", "reverses_document"],
    "lines": [
      {
        "for": "each_line",
        "side": "debit",
        "account": {
          "code": "2150"
        },
        "amount": "line.amount",
        "when": {
          "line.kind": "item"
        }
      },
      {
        "for": "each_line",
        "side": "credit",
        "account": {
          "from": "party.payable_account"
        },
        "amount": "line.total_incl_tax",
        "when": {
          "line.kind": "item"
        }
      },
      {
        "for": "each_line",
        "side": "debit",
        "account": {
          "from": "line.account"
        },
        "amount": "line.amount",
        "when": {
          "line.kind": "account"
        }
      },
      {
        "for": "each_line",
        "side": "credit",
        "account": {
          "from": "party.payable_account"
        },
        "amount": "line.total_incl_tax",
        "when": {
          "line.kind": "account"
        }
      },
      {
        "for": "each_tax",
        "side": "debit",
        "account": {
          "from": "tax_code.input_account"
        },
        "amount": "tax.amount"
      }
    ],
    "inventory": {
      "effect": "none"
    },
    "tax": {
      "applies": true,
      "inclusive": "header.tax_inclusive"
    },
    "numbering": {
      "series": "PCN",
      "assignAt": "issue"
    },
    "reversal": {
      "allowed": false,
      "producesType": null
    },
    "approval": {
      "required": false,
      "approve": null,
      "post": "accounting.purchase.post",
      "create": "accounting.purchase.create"
    },
    "fxRoundingAccount": {
      "from": "company.fx_rounding_account_id"
    },
    "dimensions": {
      "required": []
    }
  }
}
