{
  "code": "DELIVERY_ORDER",
  "nameEn": "Delivery Order",
  "nameAr": "أمر تسليم",
  "module": "inventory",
  "policyVersion": 1,
  "effectiveFrom": "2026-01-01",
  "policy": {
    "version": 1,
    "documentType": "DELIVERY_ORDER",
    "direction": "outbound",
    "requires": ["party", "warehouse"],
    "lines": [
      {
        "for": "each_line",
        "side": "debit",
        "account": { "code": "1250" },
        "amount": "line.cost",
        "when": { "line.kind": "item" }
      },
      {
        "for": "each_line",
        "side": "credit",
        "account": { "from": "item.inventory_account" },
        "amount": "line.cost",
        "when": { "line.kind": "item" }
      }
    ],
    "inventory": {
      "effect": "issue",
      "warehouse": "line.warehouse",
      "costing": "consume_layers",
      "allowNegative": true
    },
    "tax": { "applies": false },
    "numbering": { "series": "DO", "assignAt": "issue" },
    "reversal": { "allowed": true, "producesType": "DELIVERY_ORDER" },
    "approval": {
      "required": false,
      "approve": null,
      "post": "inventory.transfer.post",
      "create": "inventory.transfer.create"
    },
    "fxRoundingAccount": { "from": "company.fx_rounding_account_id" },
    "dimensions": { "required": ["BRANCH"] }
  }
}
