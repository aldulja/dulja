{
  "code": "TILL_BANKING",
  "nameEn": "Till Banking",
  "nameAr": "إيداع بنكي من الصندوق",
  "module": "pos",
  "policyVersion": 1,
  "effectiveFrom": "2026-01-01",
  "policy": {
    "version": 1,
    "documentType": "TILL_BANKING",
    "direction": "internal",
    "requires": ["client_ref", "attributed_to"],
    "lines": [
      {
        "for": "each_line",
        "side": "debit",
        "account": {
          "from": "line.account"
        },
        "amount": "line.debit",
        "when": {
          "line.kind": "account"
        }
      },
      {
        "for": "each_line",
        "side": "credit",
        "account": {
          "from": "line.account"
        },
        "amount": "line.credit",
        "when": {
          "line.kind": "account"
        }
      }
    ],
    "inventory": {
      "effect": "none"
    },
    "tax": {
      "applies": false
    },
    "numbering": {
      "series": "TBK",
      "assignAt": "issue"
    },
    "reversal": {
      "allowed": true,
      "producesType": "TILL_BANKING"
    },
    "approval": {
      "required": false,
      "approve": null,
      "post": "pos.sync.push"
    },
    "fxRoundingAccount": {
      "from": "company.fx_rounding_account_id"
    },
    "dimensions": {
      "required": ["BRANCH"]
    }
  }
}
