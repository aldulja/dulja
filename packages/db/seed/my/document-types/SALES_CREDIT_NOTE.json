{
  "code": "SALES_CREDIT_NOTE",
  "nameEn": "Sales Credit Note",
  "nameAr": "\u0625\u0634\u0639\u0627\u0631 \u062f\u0627\u0626\u0646 \u0644\u0644\u0628\u064a\u0639",
  "module": "accounting",
  "policyVersion": 2,
  "effectiveFrom": "2026-01-01",
  "policy": {
    "version": 1,
    "documentType": "SALES_CREDIT_NOTE",
    "direction": "inbound",
    "requires": ["party", "reverses_document"],
    "lines": [
      {
        "for": "each_line",
        "side": "debit",
        "account": {
          "from": "party.receivable_account"
        },
        "amount": "line.total_incl_tax",
        "when": {
          "line.kind": "item"
        }
      },
      {
        "for": "each_line",
        "side": "credit",
        "account": {
          "from": "item.revenue_account"
        },
        "amount": "line.amount",
        "when": {
          "line.kind": "item"
        }
      },
      {
        "for": "each_line",
        "side": "debit",
        "account": {
          "from": "party.receivable_account"
        },
        "amount": "line.total_incl_tax",
        "when": {
          "line.kind": "account"
        }
      },
      {
        "for": "each_line",
        "side": "credit",
        "account": {
          "from": "line.account"
        },
        "amount": "line.amount",
        "when": {
          "line.kind": "account"
        }
      },
      {
        "for": "each_line",
        "side": "debit",
        "account": {
          "from": "item.cogs_account"
        },
        "amount": "line.cost",
        "when": {
          "item.kind": "product"
        }
      },
      {
        "for": "each_line",
        "side": "credit",
        "account": {
          "code": "1250"
        },
        "amount": "line.cost",
        "when": {
          "item.kind": "product"
        }
      },
      {
        "for": "each_tax",
        "side": "credit",
        "account": {
          "from": "tax_code.output_account"
        },
        "amount": "tax.amount"
      }
    ],
    "inventory": {
      "effect": "none"
    },
    "tax": {
      "applies": true,
      "inclusive": "header.tax_inclusive"
    },
    "numbering": {
      "series": "CN",
      "assignAt": "issue"
    },
    "reversal": {
      "allowed": false,
      "producesType": null
    },
    "approval": {
      "required": false,
      "approve": null,
      "post": "accounting.sales.post",
      "create": "accounting.sales.create"
    },
    "fxRoundingAccount": {
      "from": "company.fx_rounding_account_id"
    },
    "dimensions": {
      "required": ["BRANCH"]
    }
  }
}
