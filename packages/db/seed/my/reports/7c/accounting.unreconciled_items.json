{
  "definitionVersion": 1,
  "definition": {
    "version": 1,
    "code": "accounting.unreconciled_items",
    "nameEn": "Unreconciled bank items",
    "nameAr": "بنود بنكية غير مسواة",
    "module": "accounting",
    "permission": "accounting.bank.reconcile",
    "parameters": [
      { "name": "isMatched", "kind": "enum", "required": true, "options": ["false", "true"] },
      { "name": "bankAccountId", "kind": "account", "required": false },
      { "name": "fromDate", "kind": "date", "required": false },
      { "name": "toDate", "kind": "date", "required": false }
    ],
    "dataset": {
      "source": "bank_statement_line",
      "filters": [
        { "field": "is_matched", "op": "eq", "param": "isMatched" },
        { "field": "bank_account_id", "op": "eq", "param": "bankAccountId" },
        { "field": "value_date", "op": "gte", "param": "fromDate" },
        { "field": "value_date", "op": "lte", "param": "toDate" }
      ]
    },
    "columns": [
      {
        "field": "bank_account_code",
        "labelEn": "Bank account",
        "labelAr": "الحساب البنكي",
        "format": "text",
        "align": "start",
        "width": 110
      },
      {
        "field": "statement_date",
        "labelEn": "Statement",
        "labelAr": "الكشف",
        "format": "date",
        "align": "start",
        "width": 100
      },
      {
        "field": "value_date",
        "labelEn": "Value date",
        "labelAr": "تاريخ القيمة",
        "format": "date",
        "align": "start",
        "width": 100
      },
      {
        "field": "line_no",
        "labelEn": "Line",
        "labelAr": "السطر",
        "format": "integer",
        "align": "end",
        "width": 60
      },
      {
        "field": "description",
        "labelEn": "Description",
        "labelAr": "الوصف",
        "format": "text",
        "align": "start"
      },
      {
        "field": "reference",
        "labelEn": "Reference",
        "labelAr": "المرجع",
        "format": "text",
        "align": "start",
        "width": 110
      },
      {
        "field": "currency",
        "labelEn": "Currency",
        "labelAr": "العملة",
        "format": "text",
        "align": "start",
        "width": 70
      },
      {
        "field": "amount",
        "labelEn": "Amount",
        "labelAr": "المبلغ",
        "format": "money",
        "align": "end",
        "width": 110
      },
      {
        "field": "matched_amount",
        "labelEn": "Matched",
        "labelAr": "المسوى",
        "format": "money",
        "align": "end",
        "width": 110
      },
      {
        "field": "is_matched",
        "labelEn": "Reconciled",
        "labelAr": "مسوى",
        "format": "text",
        "align": "start",
        "width": 90
      },
      {
        "field": "line_id",
        "labelEn": "Line id",
        "labelAr": "معرف السطر",
        "format": "text",
        "align": "start",
        "width": 8
      }
    ],
    "groups": [{ "field": "bank_account_code", "subtotal": true }],
    "totals": [{ "field": "amount", "fn": "sum" }],
    "sort": [
      { "field": "value_date", "dir": "asc" },
      { "field": "line_no", "dir": "asc" }
    ],
    "layout": {
      "orientation": "landscape",
      "paper": "A4",
      "header": "{title} — {isMatched}",
      "footer": "{rowCount} lines · {generatedAt}"
    },
    "tieOut": { "kind": "projection", "projection": "bank_statement_line" }
  }
}
