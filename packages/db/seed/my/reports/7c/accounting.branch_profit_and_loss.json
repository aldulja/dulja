{
  "definitionVersion": 1,
  "definition": {
    "version": 1,
    "code": "accounting.branch_profit_and_loss",
    "nameEn": "Branch profit and loss",
    "nameAr": "الأرباح والخسائر حسب الفرع",
    "module": "accounting",
    "permission": "accounting.report.read",
    "columns": [
      {
        "field": "branch_code",
        "labelEn": "Branch",
        "labelAr": "الفرع",
        "format": "text",
        "align": "start",
        "width": 100
      },
      {
        "field": "section_label",
        "labelEn": "Section",
        "labelAr": "القسم",
        "format": "text",
        "align": "start",
        "width": 120
      },
      {
        "field": "account_code",
        "labelEn": "Code",
        "labelAr": "الرمز",
        "format": "text",
        "align": "start",
        "width": 80
      },
      {
        "field": "account_name_en",
        "labelEn": "Name",
        "labelAr": "الاسم",
        "format": "text",
        "align": "start"
      },
      {
        "field": "base_balance",
        "labelEn": "Balance",
        "labelAr": "الرصيد",
        "format": "money",
        "align": "end",
        "width": 120
      }
    ],
    "groups": [
      {
        "field": "branch_code",
        "subtotal": true
      },
      {
        "field": "section_label",
        "subtotal": true
      }
    ],
    "totals": [
      {
        "field": "base_balance",
        "fn": "sum"
      }
    ],
    "sort": [
      {
        "field": "branch_code",
        "dir": "asc"
      },
      {
        "field": "section_rank",
        "dir": "asc"
      },
      {
        "field": "account_code",
        "dir": "asc"
      }
    ],
    "parameters": [
      {
        "name": "fiscalPeriodId",
        "kind": "period",
        "required": true
      },
      {
        "name": "branchId",
        "kind": "branch",
        "required": false
      }
    ],
    "dataset": {
      "source": "account_balance",
      "filters": [
        {
          "field": "fiscal_period_id",
          "op": "eq",
          "param": "fiscalPeriodId"
        },
        {
          "field": "branch_id",
          "op": "eq",
          "param": "branchId"
        }
      ]
    },
    "layout": {
      "orientation": "landscape",
      "paper": "A4",
      "header": "{title} — {fiscalPeriodId}",
      "footer": "{rowCount} accounts · {generatedAt}"
    },
    "tieOut": {
      "kind": "ledger_sum"
    }
  }
}
