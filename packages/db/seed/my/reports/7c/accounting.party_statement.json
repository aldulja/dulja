{
  "definitionVersion": 1,
  "definition": {
    "version": 1,
    "code": "accounting.party_statement",
    "nameEn": "Customer / vendor statement",
    "nameAr": "كشف حساب العميل / المورد",
    "module": "accounting",
    "permission": "accounting.report.read",
    "parameters": [
      { "name": "partyId", "kind": "party", "required": true },
      { "name": "fromDate", "kind": "date", "required": true },
      { "name": "toDate", "kind": "date", "required": true },
      { "name": "documentTypeCode", "kind": "text", "required": false }
    ],
    "dataset": {
      "source": "document",
      "filters": [
        { "field": "party_id", "op": "eq", "param": "partyId" },
        { "field": "effective_date", "op": "gte", "param": "fromDate" },
        { "field": "effective_date", "op": "lte", "param": "toDate" },
        { "field": "document_type_code", "op": "eq", "param": "documentTypeCode" }
      ]
    },
    "columns": [
      {
        "field": "effective_date",
        "labelEn": "Date",
        "labelAr": "التاريخ",
        "format": "date",
        "align": "start",
        "width": 90
      },
      {
        "field": "document_type_code",
        "labelEn": "Type",
        "labelAr": "النوع",
        "format": "text",
        "align": "start",
        "width": 130
      },
      {
        "field": "series",
        "labelEn": "Series",
        "labelAr": "السلسلة",
        "format": "text",
        "align": "start",
        "width": 70
      },
      {
        "field": "number",
        "labelEn": "Number",
        "labelAr": "الرقم",
        "format": "integer",
        "align": "end",
        "width": 80
      },
      {
        "field": "status",
        "labelEn": "Status",
        "labelAr": "الحالة",
        "format": "text",
        "align": "start",
        "width": 80
      },
      {
        "field": "currency",
        "labelEn": "Currency",
        "labelAr": "العملة",
        "format": "text",
        "align": "start",
        "width": 70
      },
      {
        "field": "base_total",
        "labelEn": "Base total",
        "labelAr": "الإجمالي الأساسي",
        "format": "money",
        "align": "end",
        "width": 120
      },
      {
        "field": "document_id",
        "labelEn": "Document id",
        "labelAr": "معرف المستند",
        "format": "text",
        "align": "start",
        "width": 8
      },
      {
        "field": "posting_seq",
        "labelEn": "Seq",
        "labelAr": "التسلسل",
        "format": "integer",
        "align": "end",
        "width": 8
      }
    ],
    "groups": [],
    "totals": [
      { "field": "base_total", "fn": "sum" },
      { "field": "document_id", "fn": "count" }
    ],
    "sort": [
      { "field": "effective_date", "dir": "asc" },
      { "field": "posting_seq", "dir": "asc" }
    ],
    "layout": {
      "orientation": "portrait",
      "paper": "A4",
      "header": "{title} — {fromDate} … {toDate}",
      "footer": "{rowCount} documents · {generatedAt}"
    },
    "tieOut": { "kind": "ledger_sum" }
  }
}
