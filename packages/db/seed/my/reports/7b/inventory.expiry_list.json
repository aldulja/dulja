{
  "definitionVersion": 1,
  "definition": {
    "version": 1,
    "code": "inventory.expiry_list",
    "nameEn": "Expiry list",
    "nameAr": "قائمة تواريخ انتهاء الصلاحية",
    "module": "inventory",
    "permission": "inventory.stock.read",
    "parameters": [
      { "name": "beforeDate", "kind": "date", "required": true },
      { "name": "itemId", "kind": "item", "required": false }
    ],
    "dataset": {
      "source": "lot",
      "filters": [
        { "field": "expires_on", "op": "lte", "param": "beforeDate" },
        { "field": "item_id", "op": "eq", "param": "itemId" }
      ]
    },
    "columns": [
      {
        "field": "expires_on",
        "labelEn": "Expires",
        "labelAr": "تاريخ الانتهاء",
        "format": "date",
        "align": "start",
        "width": 90
      },
      {
        "field": "days_to_expiry",
        "labelEn": "Days left",
        "labelAr": "الأيام المتبقية",
        "format": "integer",
        "align": "end",
        "width": 70
      },
      {
        "field": "item_code",
        "labelEn": "Item",
        "labelAr": "الصنف",
        "format": "text",
        "align": "start",
        "width": 90
      },
      {
        "field": "item_name_en",
        "labelEn": "Item name",
        "labelAr": "اسم الصنف",
        "format": "text",
        "align": "start",
        "width": 180
      },
      {
        "field": "code",
        "labelEn": "Lot",
        "labelAr": "الدفعة",
        "format": "text",
        "align": "start",
        "width": 90
      },
      {
        "field": "manufactured_on",
        "labelEn": "Manufactured",
        "labelAr": "تاريخ الإنتاج",
        "format": "date",
        "align": "start",
        "width": 90
      }
    ],
    "groups": [{ "field": "item_code", "subtotal": true }],
    "totals": [{ "field": "days_to_expiry", "fn": "count" }],
    "sort": [
      { "field": "expires_on", "dir": "asc" },
      { "field": "item_code", "dir": "asc" }
    ],
    "layout": {
      "orientation": "portrait",
      "paper": "A4",
      "header": "{title} — {beforeDate}",
      "footer": "{rowCount} lots · {generatedAt}"
    },
    "tieOut": { "kind": "none" }
  }
}
