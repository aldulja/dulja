{
  "definitionVersion": 1,
  "definition": {
    "version": 1,
    "code": "accounting.period_comparison",
    "nameEn": "Period comparison",
    "nameAr": "مقارنة الفترات",
    "module": "accounting",
    "permission": "accounting.report.read",
    "parameters": [
      {
        "name": "fiscalPeriodId",
        "kind": "period",
        "required": true
      },
      {
        "name": "accountType",
        "kind": "enum",
        "required": false,
        "options": ["asset", "liability", "equity", "income", "expense"]
      }
    ],
    "dataset": {
      "source": "account_balance",
      "filters": [
        {
          "field": "fiscal_period_id",
          "op": "eq",
          "param": "fiscalPeriodId"
        },
        {
          "field": "account_type",
          "op": "eq",
          "param": "accountType"
        }
      ]
    },
    "columns": [
      {
        "field": "account_code",
        "labelEn": "Account",
        "labelAr": "الحساب",
        "format": "text",
        "align": "start",
        "width": 70
      },
      {
        "field": "account_name_en",
        "labelEn": "Account name",
        "labelAr": "اسم الحساب",
        "format": "text",
        "align": "start",
        "width": 180
      },
      {
        "field": "account_type",
        "labelEn": "Type",
        "labelAr": "النوع",
        "format": "text",
        "align": "start",
        "width": 80
      },
      {
        "field": "currency",
        "labelEn": "Currency",
        "labelAr": "العملة",
        "format": "text",
        "align": "start",
        "width": 50
      },
      {
        "field": "base_debit",
        "labelEn": "Debit",
        "labelAr": "مدين",
        "format": "money",
        "align": "end",
        "width": 100
      },
      {
        "field": "base_credit",
        "labelEn": "Credit",
        "labelAr": "دائن",
        "format": "money",
        "align": "end",
        "width": 100
      },
      {
        "field": "base_balance",
        "labelEn": "Net",
        "labelAr": "الصافي",
        "format": "money",
        "align": "end",
        "width": 100
      }
    ],
    "groups": [
      {
        "field": "account_type",
        "subtotal": true
      }
    ],
    "totals": [
      {
        "field": "base_balance",
        "fn": "sum"
      }
    ],
    "sort": [
      {
        "field": "account_code",
        "dir": "asc"
      },
      {
        "field": "currency",
        "dir": "asc"
      }
    ],
    "layout": {
      "orientation": "portrait",
      "paper": "A4",
      "header": "{title} — {fiscalPeriodId}",
      "footer": "{rowCount} lines · {generatedAt}"
    },
    "tieOut": {
      "kind": "ledger_sum"
    }
  }
}
