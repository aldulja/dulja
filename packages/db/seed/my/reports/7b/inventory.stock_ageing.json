{
  "definitionVersion": 1,
  "definition": {
    "version": 1,
    "code": "inventory.stock_ageing",
    "nameEn": "Stock ageing",
    "nameAr": "أعمار المخزون",
    "module": "inventory",
    "permission": "inventory.cost.read",
    "parameters": [
      { "name": "itemId", "kind": "item", "required": true },
      { "name": "warehouseId", "kind": "warehouse", "required": false }
    ],
    "dataset": {
      "source": "cost_layer",
      "filters": [
        { "field": "item_id", "op": "eq", "param": "itemId" },
        { "field": "warehouse_id", "op": "eq", "param": "warehouseId" }
      ]
    },
    "columns": [
      {
        "field": "warehouse_code",
        "labelEn": "Warehouse",
        "labelAr": "المستودع",
        "format": "text",
        "align": "start",
        "width": 90
      },
      {
        "field": "lot_code",
        "labelEn": "Lot",
        "labelAr": "الدفعة",
        "format": "text",
        "align": "start",
        "width": 90
      },
      {
        "field": "effective_at",
        "labelEn": "Received",
        "labelAr": "تاريخ الاستلام",
        "format": "date",
        "align": "start",
        "width": 90
      },
      {
        "field": "age_days",
        "labelEn": "Days",
        "labelAr": "الأيام",
        "format": "integer",
        "align": "end",
        "width": 60
      },
      {
        "field": "sequence",
        "labelEn": "Layer",
        "labelAr": "الطبقة",
        "format": "integer",
        "align": "end",
        "width": 50
      },
      {
        "field": "qty_in",
        "labelEn": "Received qty",
        "labelAr": "الكمية المستلمة",
        "format": "quantity",
        "align": "end",
        "width": 100
      },
      {
        "field": "qty_remaining",
        "labelEn": "Remaining",
        "labelAr": "الكمية المتبقية",
        "format": "quantity",
        "align": "end",
        "width": 100
      },
      {
        "field": "unit_cost",
        "labelEn": "Unit cost",
        "labelAr": "تكلفة الوحدة",
        "format": "money",
        "align": "end",
        "width": 100
      }
    ],
    "groups": [{ "field": "warehouse_code", "subtotal": true }],
    "totals": [{ "field": "qty_remaining", "fn": "sum" }],
    "sort": [
      { "field": "effective_at", "dir": "asc" },
      { "field": "sequence", "dir": "asc" }
    ],
    "layout": {
      "orientation": "landscape",
      "paper": "A4",
      "header": "{title} — {itemId}",
      "footer": "{rowCount} layers · {generatedAt}"
    },
    "tieOut": { "kind": "projection", "projection": "stock_valuation" }
  }
}
