{
  "definitionVersion": 2,
  "definition": {
    "version": 1,
    "code": "inventory.valuation",
    "nameEn": "Stock valuation",
    "nameAr": "تقييم المخزون",
    "module": "inventory",
    "permission": "inventory.cost.read",
    "parameters": [
      { "name": "asOf", "kind": "date", "required": true },
      { "name": "itemId", "kind": "item", "required": false },
      { "name": "warehouseId", "kind": "warehouse", "required": false }
    ],
    "dataset": {
      "source": "stock_valuation",
      "filters": [
        { "field": "as_of", "op": "eq", "param": "asOf" },
        { "field": "item_id", "op": "eq", "param": "itemId" },
        { "field": "warehouse_id", "op": "eq", "param": "warehouseId" }
      ]
    },
    "columns": [
      {
        "field": "item_code",
        "labelEn": "Item",
        "labelAr": "الصنف",
        "format": "text",
        "align": "start",
        "width": 90
      },
      {
        "field": "item_name_en",
        "labelEn": "Item name",
        "labelAr": "اسم الصنف",
        "format": "text",
        "align": "start",
        "width": 200
      },
      {
        "field": "warehouse_code",
        "labelEn": "Warehouse",
        "labelAr": "المستودع",
        "format": "text",
        "align": "start",
        "width": 90
      },
      {
        "field": "quantity",
        "labelEn": "Quantity",
        "labelAr": "الكمية",
        "format": "quantity",
        "align": "end",
        "width": 100
      },
      {
        "field": "value",
        "labelEn": "Value",
        "labelAr": "القيمة",
        "format": "money",
        "align": "end",
        "width": 120
      }
    ],
    "groups": [{ "field": "item_code", "subtotal": true }],
    "totals": [
      { "field": "value", "fn": "sum" },
      { "field": "quantity", "fn": "sum" }
    ],
    "sort": [
      { "field": "item_code", "dir": "asc" },
      { "field": "warehouse_code", "dir": "asc" }
    ],
    "layout": {
      "orientation": "portrait",
      "paper": "A4",
      "header": "{title} — {asOf}",
      "footer": "{rowCount} rows · {generatedAt}"
    },
    "tieOut": { "kind": "projection", "projection": "stock_valuation" }
  }
}
