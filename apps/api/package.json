    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@sentry/node": "^10.74.0",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "playwright": "^1.63.0",
    "postgres": "^3.4.9",
    "uuid": "^14.0.2",
    "zod": "^4.6.4"
